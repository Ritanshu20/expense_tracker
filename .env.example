# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# True only on your own machine. Anything else (or unset) means False.
DEBUG=True

# Comma-separated, no spaces needed.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional, for production. With DEBUG off, HTTPS is required and HSTS lasts one hour by default.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# Optional. The budget warning starts at this percent of the budget. Default 80.
# BUDGET_WARNING_THRESHOLD_PERCENT=80

# Database (PostgreSQL only). Use EITHER DATABASE_URL (preferred) ...
# DATABASE_URL=postgres://expense_tracker_user:your-password@localhost:5432/expense_tracker

# ... OR the separate values below.
DB_NAME=expense_tracker
DB_USER=expense_tracker_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
